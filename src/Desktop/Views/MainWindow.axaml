<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CampusBorrowing.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
        x:Class="CampusBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Campus Equipment Borrowing System">

    <Window.Styles>
    <!-- Buttons -->
    <Style Selector="Button">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="#2D6CDF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1F55B8"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- Sidebar nav buttons (if you gave them a class) -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#E8EEFB"/>
    </Style>

    <!-- Headings -->
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>

    <!-- Status/feedback text -->
    <Style Selector="TextBlock.status">
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="#555555"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- Lists -->
    <Style Selector="ListBox">
        <Setter Property="Margin" Value="0,4,0,4"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="#DDDDDD"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="8,6"/>
    </Style>
</Window.Styles>

    <Grid ColumnDefinitions="160,*" Margin="16">

        <!-- NAVIGATION SIDEBAR -->
        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
            <TextBlock Text="Campus Equipment Borrowing System" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16" />

            <Button Content="Equipment"
                    Command="{Binding ShowEquipmentCommand}"
                    HorizontalAlignment="Stretch" />

            <Button Content="Active Borrowings"
                    Command="{Binding ShowBorrowingsCommand}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- EQUIPMENT PAGE -->
        <StackPanel Grid.Column="1" Spacing="8" IsVisible="{Binding IsEquipmentViewActive}">
            <TextBlock Text="Equipment" FontSize="18" FontWeight="Bold" />

            <ListBox ItemsSource="{Binding EquipmentList}"
                     SelectedItem="{Binding SelectedEquipment}"
                     Height="250">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="11" />
                            <TextBlock Text="{Binding Availability, StringFormat='Available: {0}'}" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Student ID" FontWeight="Bold" Margin="0,8,0,0" />
            <NumericUpDown Value="{Binding StudentIdInput}" Minimum="1" />

            <Button Content="Borrow Equipment"
                    Command="{Binding BorrowCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0" />

            <Border Background="#EEEEEE" Padding="8" Margin="0,16,0,0">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- BORROWINGS PAGE -->
        <StackPanel Grid.Column="1" Spacing="8" IsVisible="{Binding IsBorrowingsViewActive}">
            <TextBlock Text="Active Borrowings" FontSize="18" FontWeight="Bold" />

            <ListBox ItemsSource="{Binding ActiveBorrowings}"
                     SelectedItem="{Binding SelectedBorrowing}"
                     Height="250">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Id, StringFormat='Borrowing ID: {0}'}" FontWeight="Bold" />
                            <TextBlock Text="{Binding EquipmentId, StringFormat='Equipment ID: {0}'}" FontSize="11" />
                            <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Return Equipment"
                    Command="{Binding ReturnCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0" />

            <Border Background="#EEEEEE" Padding="8" Margin="0,16,0,0">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

    </Grid>

</Window>